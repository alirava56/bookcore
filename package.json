{
  "name": "bookcore-backend",
  "version": "0.16.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/main.js",
    "start:dev": "npm run build && npm run start",
    "lint": "eslint 'apps/api/**/*.ts' 'scripts/**/*.ts' --max-warnings=0",
    "format:check": "prettier --check 'apps/api/**/*.ts' 'scripts/**/*.ts'",
    "test:unit": "node scripts/run-tests.cjs unit",
    "test:integration": "node scripts/run-tests.cjs integration",
    "test:database": "node scripts/run-tests.cjs database",
    "test:concurrency": "node scripts/run-tests.cjs concurrency",
    "test": "npm run test:unit && npm run test:integration",
    "migrate": "node dist/scripts/migrate.js",
    "openapi:current": "node dist/scripts/generate-openapi.js",
    "verify:static": "node scripts/static-verify.cjs && node scripts/verify-migration-checksums.cjs && node scripts/phase07-static-verify.cjs && node scripts/phase08-static-check.cjs && node scripts/phase10-static-check.cjs && node scripts/phase11-static-check.cjs && node scripts/phase12-static-check.cjs && node scripts/phase13-static-check.cjs && node scripts/phase14-static-check.cjs",
    "verify:reference": "node scripts/verify-reference.cjs",
    "verify": "npm run verify:reference && npm run verify:static && npm run typecheck && npm run lint && npm run build && npm run test",
    "test:availability:isolated": "node scripts/test-availability-pure.cjs",
    "test:session-domain:isolated": "node scripts/test-session-domain-pure.cjs",
    "auth:limits:prune": "node dist/scripts/prune-auth-rate-limits.js",
    "test:booking:isolated": "node scripts/test-booking-domain-pure.cjs",
    "outbox:worker": "node dist/scripts/outbox-worker.js",
    "outbox:recovery": "node dist/scripts/outbox-recovery.js",
    "test:phase08:isolated": "node scripts/test-phase08-pure.cjs",
    "test:phase09:isolated": "node scripts/test-phase09-pure.cjs",
    "ops:inspect": "node dist/scripts/operational-integrity.js",
    "ops:maintenance": "node dist/scripts/lifecycle-maintenance.js",
    "test:phase10:isolated": "node scripts/test-phase10-pure.cjs",
    "ops:inspect:paged": "node dist/scripts/operational-inspection-v2.js",
    "test:phase11:isolated": "node scripts/test-phase11-pure.cjs",
    "test:phase12:isolated": "node scripts/test-phase12-pure.cjs",
    "ops:backup": "node scripts/recovery/backup.cjs",
    "ops:backup:verify": "node scripts/recovery/verify-backup.cjs",
    "ops:restore": "node scripts/recovery/restore.cjs",
    "ops:retention:preview": "node scripts/recovery/retention-preview.cjs",
    "ops:storage:inspect": "node scripts/recovery/storage-growth.cjs",
    "test:phase13:isolated": "node scripts/test-phase13-pure.cjs",
    "perf:booking:postgres": "node --test dist/apps/api/test/integration/booking-postgres.test.js",
    "ops:recovery:verify": "node scripts/recovery/verify-backup.cjs",
    "test:phase14:isolated": "node scripts/test-phase14-pure.cjs",
    "verify:runtime:preflight": "node scripts/phase14-runtime-preflight.cjs",
    "test:postgres:booking": "node --test dist/apps/api/test/integration/booking-postgres.test.js",
    "test:recovery": "node scripts/run-tests.cjs recovery",
    "verify:release-manifest": "node scripts/verify-manifest.cjs --mode=release",
    "verify:workspace-manifest": "node scripts/verify-manifest.cjs --mode=workspace",
    "manifest:freeze": "node scripts/generate-manifest.cjs --write-release",
    "test:phase15:isolated": "node --test scripts/phase15-regression.test.cjs",
    "test:phase16:isolated": "node scripts/test-phase16-pure.cjs"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.0",
    "@types/express": "5.0.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.5",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.74.0"
  }
}
