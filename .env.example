# DEV ONLY: replace every placeholder with independent values; never use examples in production.
NODE_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# PostgreSQL runtime role must NOT own schema or migrations
DATABASE_URL=postgres://bookcore_app:CHANGE_ME_DEV_ONLY@127.0.0.1:55432/bookcore
# Privileged migration role must be used only by `npm run migrate`
MIGRATION_DATABASE_URL=postgres://bookcore_owner:CHANGE_ME_DIFFERENT_DEV_ONLY@127.0.0.1:55432/bookcore
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=3000
TX_LOCK_TIMEOUT_MS=2000
TX_STATEMENT_TIMEOUT_MS=5000
HEALTH_QUERY_TIMEOUT_MS=1500
LOG_LEVEL=info
TRUSTED_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=64kb
# Generate a random 32+-character value locally. Example intentionally not a usable key.
MONITOR_API_KEY=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
MONITOR_ALLOWED_IPS=127.0.0.1,::1
ENABLE_SWAGGER_UI=false

# PHASE 04: provide independently generated 32+ byte values; examples here are INERT placeholders.
AUTH_JWT_ISSUER=https://bookcore.example.invalid
AUTH_JWT_AUDIENCE=bookcore-api
AUTH_JWT_ACTIVE_KID=k2026
AUTH_JWT_KEYS_JSON={"k2026":"REPLACE_WITH_32_OR_MORE_RANDOM_BYTES_OF_SECRET_KEY"}
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Phase10 operations: supply real distinct per-person PostgreSQL LOGIN credentials through secrets manager.
# These variables are NOT required for ordinary API startup and must NEVER use DATABASE_URL.
# OUTBOX_OPS_DATABASE_URL=
# BOOKCORE_INSPECT_DATABASE_URL=
# BOOKCORE_MAINTENANCE_DATABASE_URL=

# Phase11 read-only paged inspection: generate 32 random bytes, encode base64url; store as a secret.
# BOOKCORE_INSPECTION_CURSOR_KEY=REPLACE_WITH_FRESH_RANDOM_BASE64URL_32_BYTES
# Never set BOOKCORE_TEST_DATABASE_DISPOSABLE=yes against a production database.

# Phase13 observability - per API instance
MAX_INFLIGHT_REQUESTS=64
# Protected operational recovery - supply these ONLY through dedicated operational runtime
# BOOKCORE_RESTORE_ALLOWED_LOGIN=designated_restore_login
# BOOKCORE_RESTORE_ISOLATED_INSTANCE=yes  # external offline isolation also required
# BOOKCORE_EXPECTED_SOURCE_DATABASE=bookcore
# BOOKCORE_TRUSTED_MANIFEST_SHA256=<SHA from independent trusted store>
# BOOKCORE_PGDUMP_BIN=/usr/bin/pg_dump
# BOOKCORE_PGRESTORE_BIN=/usr/bin/pg_restore
# BOOKCORE_PSQL_BIN=/usr/bin/psql
# BOOKCORE_AGE_BIN=/usr/bin/age
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/private/trusted/ca.crt
